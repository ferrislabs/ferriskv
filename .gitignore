# Rust build output
/target
**/*.rs.bk
*.pdb

# Local runtime data (created by the binaries on first start)
/data
/tmp

# Local configuration (commit examples under config/ if you want)
/config/*.local.toml
/config/*.secret.toml

# Coverage reports
/lcov.info
/coverage
*.profraw
*.profdata

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Direnv and env files
.envrc
.env
.env.local

# Logs
*.log

# Website (Turborepo / Astro monorepo under ./website)
website/**/node_modules/
website/**/.turbo/
website/**/.astro/
website/**/dist/
website/**/build/
website/**/.cache/
website/**/coverage/
website/**/*.tsbuildinfo
website/**/.env
website/**/.env.*
!website/**/.env.example
website/**/npm-debug.log*
website/**/yarn-debug.log*
website/**/yarn-error.log*
website/**/pnpm-debug.log*
