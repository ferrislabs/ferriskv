node_id = "node-0"
listen = "0.0.0.0:7100"
admin_listen = "127.0.0.1:7101"
data_dir = "/tmp/ferriskv-node"
coord_endpoints = ["c0:7000", "c1:7000"]
backend = "memory"
shutdown_timeout_secs = 30
ttl_sweep_interval_secs = 60
wal_rotate_bytes = 8388608

[auth]
insecure = false
public_key_path = "/etc/ferriskv/idp.pub"

[tls]
cert_path = "/etc/ferriskv/server.crt"
key_path = "/etc/ferriskv/server.key"

[limits]
max_key_size = 4096
max_value_size = 10485760
max_batch_ops = 1000
max_scan_limit = 10000
